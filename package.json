{
  "name": "standalone-agent-orchestrator",
  "version": "0.2.0-alpha.1",
  "description": "Local, durable Claude Code and Codex subagent orchestration over MCP",
  "type": "module",
  "bin": {
    "agent-orchestrator": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:live": "tsx test/live.ts",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "pretest:live": "npm run build",
    "pretest:live:controls": "npm run build",
    "test:live:controls": "tsx test/live-controls.ts",
    "format": "prettier --write src test package.json tsconfig.json",
    "format:check": "prettier --check src test package.json tsconfig.json",
    "pretest:live:nesting": "npm run build",
    "test:live:nesting": "tsx test/live-nesting.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@modelcontextprotocol/sdk": "1.32.2",
    "google-auth-library": "10.9.1",
    "playwright": "1.64.1",
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muratangin187/subagent-orchestrator.git"
  },
  "homepage": "https://github.com/muratangin187/subagent-orchestrator#readme",
  "bugs": {
    "url": "https://github.com/muratangin187/subagent-orchestrator/issues"
  },
  "keywords": [
    "mcp",
    "codex",
    "claude-code",
    "subagents",
    "orchestration"
  ]
}
